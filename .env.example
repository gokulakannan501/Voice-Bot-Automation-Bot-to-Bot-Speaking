PORT=4001
PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.dev

# Sarvam AI (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Anthropic Claude (Primary LLM Engine for Telephony)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Google Gemini (Fallback Evaluation & Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Exotel Voice API Configuration
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_APP_ID=your_exotel_app_id_here

# Target Bot Configuration (Optional default)
TARGET_BOT_NUMBER=080XXXXXXXX
TARGET_BOT_WS_URL=wss://your-target-bot.ngrok-free.dev/ws/audio
BRIDGE_PORT=4002
